[Unit]
Description=Fundraise Application
After=network.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=forking
User=ran
Group=ran
WorkingDirectory=/proj/www/fundraise.ph
ExecStart=/proj/www/fundraise.ph/auto-restart.sh start
ExecStop=/proj/www/fundraise.ph/auto-restart.sh stop
ExecReload=/proj/www/fundraise.ph/auto-restart.sh restart
PIDFile=/proj/www/fundraise.ph/.pids/fundraise-ph.pid
Restart=always
RestartSec=10
WatchdogSec=60
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
